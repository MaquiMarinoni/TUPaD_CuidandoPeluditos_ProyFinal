# Ejemplo de configuracion local. Copiar a .env y reemplazar los valores.
# No publicar .env ni contrasenas reales.
FLASK_ENV=dev
SECRET_KEY=REEMPLAZAR_POR_UNA_CLAVE_ALEATORIA_PROPIA
DATABASE_URL=mysql+pymysql://peluditos_app:REEMPLAZAR_CLAVE_CODIFICADA@127.0.0.1:3306/cuidandopeluditos_pruebas?charset=utf8mb4

# DATABASE_URL: codificar los caracteres especiales de la contrasena para una URL.
# La guia local ofrece una alternativa que solicita la clave sin mostrarla.
# Flask CLI carga .env mediante python-dotenv. Los scripts python -m scripts.*
# requieren las variables exportadas en su terminal; no cargan .env automaticamente.
# Si una variable ya existe en la terminal, tiene prioridad sobre .env.
# En despliegue usar FLASK_ENV=prod, SECRET_KEY propia y DATABASE_URL del servidor.
